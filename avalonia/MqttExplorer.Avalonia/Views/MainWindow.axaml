<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MqttExplorer.Avalonia.ViewModels"
        xmlns:tdg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.TreeDataGrid"
        xmlns:input="clr-namespace:Avalonia.Input;assembly=Avalonia.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MqttExplorer.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Explorador MQTT"
        Width="1400"
        Height="900">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LeftPaneWidth, Mode=TwoWay}" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="{Binding RightPaneWidth, Mode=TwoWay}" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="5" Padding="8" Background="#1F2A44" CornerRadius="6">
            <TextBlock Text="{Binding Status}" Foreground="White" />
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8" Margin="0,12,10,0">
            <TextBlock Text="Conexion" FontWeight="Bold" FontSize="16" />
            <TextBlock Text="Conexiones guardadas" />
            <ComboBox ItemsSource="{Binding SavedConnections}"
                      SelectedItem="{Binding SelectedConnection}"
                      DisplayMemberBinding="{Binding Name}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Guardar" Command="{Binding SaveConnectionCommand}" />
                <Button Content="Recargar" Command="{Binding LoadConnectionsCommand}" />
            </StackPanel>
            <TextBlock Text="Id" />
            <TextBox Text="{Binding ConnectionId}" />
            <TextBlock Text="Nombre" />
            <TextBox Text="{Binding ConnectionName}" />
            <TextBlock Text="URL del broker" />
            <TextBox Text="{Binding BrokerUrl}" />
            <TextBlock Text="Usuario" />
            <TextBox Text="{Binding Username}" />
            <TextBlock Text="Contrasena" />
            <TextBox Text="{Binding Password}" PasswordChar="*" />
            <TextBlock Text="Suscripciones (separadas por coma)" />
            <TextBox Text="{Binding Subscriptions}" />
            <CheckBox Content="TLS" IsChecked="{Binding Tls}" />
            <CheckBox Content="Validar certificados" IsChecked="{Binding CertValidation}" />
            <TextBlock Text="{Binding ConnectionValidationError}"
                       Foreground="#D13438"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasConnectionValidationError}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Conectar"
                        Command="{Binding ConnectCommand}"
                        IsEnabled="{Binding CanConnect}" />
                <Button Content="Desconectar" Command="{Binding DisconnectCommand}" />
            </StackPanel>
        </StackPanel>

        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#2B2B2B" />

        <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*" Margin="0,12,10,0">
            <TextBlock Grid.Row="0" Text="Arbol de topicos (en vivo)" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,220,8,Auto,8,Auto,8,Auto,8,*,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="Filtro:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding TopicFilter}" Watermark="contiene topico/ruta...">
                    <TextBox.KeyBindings>
                        <input:KeyBinding Gesture="Enter" Command="{Binding ApplyTopicFilterCommand}" />
                        <input:KeyBinding Gesture="Escape" Command="{Binding ClearTopicFilterCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="3" Content="Limpiar" Command="{Binding ClearTopicFilterCommand}" />
                <CheckBox Grid.Column="5" Content="Autoactualizar al navegar" IsChecked="{Binding AutoRefreshWhileBrowsing}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="9" Text="{Binding PendingUpdatesLabel}" VerticalAlignment="Center" />
                <Button Grid.Column="10"
                        Content="Aplicar actualizaciones"
                        Command="{Binding ApplyPendingUpdatesCommand}"
                        IsEnabled="{Binding HasPendingUpdates}" />
            </Grid>
            <Border Grid.Row="2" BorderThickness="1" BorderBrush="#3A3A3A" Padding="6">
                <tdg:TreeDataGrid Source="{Binding TopicTreeSource}"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.AllowAutoHide="False" />
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1"
                      Grid.Column="3"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#2B2B2B" />

        <StackPanel Grid.Row="1" Grid.Column="4" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="Carga util seleccionada" FontWeight="Bold" FontSize="16" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Copiar topico" Command="{Binding CopyTopicCommand}" IsEnabled="{Binding CanCopySelection}" />
                <Button Content="Copiar carga util" Command="{Binding CopyPayloadCommand}" IsEnabled="{Binding CanCopySelection}" />
                <Button Content="Copiar ruta" Command="{Binding CopyPathCommand}" IsEnabled="{Binding CanCopySelection}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Modo:" VerticalAlignment="Center" />
                <ComboBox Width="180"
                          ItemsSource="{Binding PayloadModes}"
                          SelectedItem="{Binding SelectedPayloadMode}" />
            </StackPanel>
            <TextBlock Text="{Binding SelectedPayloadMetadata}" TextWrapping="Wrap" Foreground="#D0D0D0" />
            <TextBox Text="{Binding SelectedPayload}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     Height="180"
                     TextWrapping="Wrap" />

            <TextBlock Text="Linea de tiempo (ultimos 25)" FontWeight="Bold" FontSize="16" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding SelectedTopicTimeline}" Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TopicTimelineEntryViewModel">
                        <Border Background="{Binding HighlightBackground}" Padding="6" Margin="0,0,0,4" CornerRadius="4">
                            <Grid ColumnDefinitions="70,70,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontFamily="Consolas" />
                                <TextBlock Grid.Column="1" Text="{Binding ChangeIndicator}" />
                                <TextBlock Grid.Column="2" Text="{Binding DiffSummary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding PayloadPreview}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Publicar" FontWeight="Bold" FontSize="16" Margin="0,8,0,0" />
            <TextBlock Text="Topico" />
            <TextBox Text="{Binding PublishTopic}" />
            <TextBlock Text="Carga util" />
            <TextBox Text="{Binding PublishPayload}" AcceptsReturn="True" Height="160" TextWrapping="Wrap" />
            <TextBlock Text="QoS" />
            <ComboBox ItemsSource="{Binding QosLevels}" SelectedItem="{Binding PublishQos}" />
            <CheckBox Content="Retener" IsChecked="{Binding PublishRetain}" />
            <Button Content="Publicar"
                    Command="{Binding PublishCommand}"
                    IsEnabled="{Binding CanPublish}" />
        </StackPanel>
    </Grid>

</Window>
